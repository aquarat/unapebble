rsource "c/Kconfig"

menu "Libraries"

config FAT_RO
    bool
    help
      Read the files of the root directory of a FAT16, FAT32 or exFAT
      volume (pbl/fat_ro/fat_ro.h).

config KRAEPELIN
    bool "Kraepelin"
    help
      Build the Kraepelin step and sleep tracking algorithm.

rsource "fuel_gauge/Kconfig"

config VANHEES
    bool "van Hees"
    help
      Build the van Hees wrist angle sleep classifier.

config VFAT
    bool
    help
      A read-only FAT16 volume computed as it is read, from a list of
      files and a callback for their data (pbl/vfat/vfat.h).

endmenu
