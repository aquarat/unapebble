/dts-v1/;

// The UNA Watch, as its stock bootloader starts the kernel image: from 0x08060000, with the
// bootloader and the shared libc below, which stay

#include "st/stm32u5a5xj.dtsi"
#include "unawatch-pinctrl.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pwm/pwm.h>

/ {
	model = "UNA Watch";
	compatible = "una,unawatch", "st,stm32u5a5";

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		// The crash dump and logs of the stock kernel, kept across resets, at the top of
		// SRAM5: left alone, so that it still finds them
		una_crash: memory@2025e000 {
			reg = <0x2025e000 0x12000>;
			no-map;
		};
	};

	// The display module's supplies: PMIC rails, on whenever the watch is
	// (docs/boards/unawatch/hardware.md, section 4.1)
	vddp: regulator-vddp {
		compatible = "regulator-fixed";
		regulator-name = "vddp";
		regulator-always-on;
	};

	vlcd: regulator-vlcd {
		compatible = "regulator-fixed";
		regulator-name = "vlcd";
		regulator-always-on;
	};

	// The reflective color memory-in-pixel panel, 240 x 240, mounted a quarter turn round: line 0
	// is the right column of the image, top to bottom. FRP and XFRP are driven separately.
	panel: panel {
		compatible = "sharp,ls012b7dd06a";
		vddp-supply = <&vddp>;
		vlcd-supply = <&vlcd>;
		pwms = <&lptim1_pwm 0 32562256 0>, <&lptim3_pwm 0 32562256 PWM_POLARITY_INVERTED>;
		rotation = <90>;
		// ENB from the last HCK edge of a line, for about 11 us at the 1 MHz the CPU clocks
		// HCK at (LS012B7DD06A.cpp:326-336 of the stock firmware)
		jdi,enable-start = <123>;
		jdi,enable-end = <134>;

		panel-timing {
			clock-frequency = <1000000>;
			hactive = <240>;
			vactive = <240>;
			hback-porch = <0>;
			hfront-porch = <0>;
			hsync-len = <0>;
			vback-porch = <0>;
			vfront-porch = <0>;
			vsync-len = <0>;
		};

		port {
			panel_in: endpoint {
				remote-endpoint = <&display_out>;
			};
		};
	};

	// The panel's interface, clocked by the CPU: the stock firmware drives it the same way
	display: display {
		compatible = "jdi-parallel-gpio";
		vst-gpios = <&gpiob 10 GPIO_ACTIVE_HIGH>;
		vck-gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;
		enb-gpios = <&gpioa 7 GPIO_ACTIVE_HIGH>;
		xrst-gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;
		hst-gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
		hck-gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>;
		data-gpios = <&gpioe 0 GPIO_ACTIVE_HIGH>, /* R1 */
			     <&gpioe 8 GPIO_ACTIVE_HIGH>, /* R2 */
			     <&gpioe 2 GPIO_ACTIVE_HIGH>, /* G1 */
			     <&gpioe 10 GPIO_ACTIVE_HIGH>, /* G2 */
			     <&gpioe 4 GPIO_ACTIVE_HIGH>, /* B1 */
			     <&gpioe 12 GPIO_ACTIVE_HIGH>; /* B2 */

		port {
			display_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};

	// The frontlight, on or off
	leds {
		compatible = "gpio-leds";

		frontlight: led-frontlight {
			label = "frontlight";
			gpios = <&gpiof 3 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
		};
	};

	backlight: backlight {
		compatible = "led-backlight";
		leds = <&frontlight>;
	};

	// Active low, with an RC filter, on the internal pull-ups; the stock firmware debounces
	// them for 50 ms (HWButtons.hpp:146). Select is also the power button, the ON key of the
	// PMIC. Their EXTI lines wake the SoC from Stop 2 as they are; nothing wakes it from
	// Standby, so they are no wakeup sources.
	buttons: gpio-keys {
		compatible = "gpio-keys";

		button-back {
			label = "SW4";
			gpios = <&gpiod 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_BACK>;
			debounce-interval = <40>;
		};

		button-up {
			label = "SW1";
			gpios = <&gpiod 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_UP>;
			debounce-interval = <40>;
		};

		button-select {
			label = "SW2";
			gpios = <&gpiod 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_SELECT>;
			debounce-interval = <40>;
		};

		button-down {
			label = "SW3";
			gpios = <&gpioa 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_DOWN>;
			debounce-interval = <40>;
		};
	};
};

// The 16 MHz crystal, for the USB HS PHY only
&clk_hse {
	clock-frequency = <16000000>;
};

// The SMPS supplies VCORE
&pwr {
	st,supply-config = "smps";
};

// The CPU and every bus at 160 MHz from PLL1 on MSIS at 48 MHz (M = 3, N = 10, R = 1); LPTIM4
// and the RTC count the external 32.768 kHz clock, an LSE in bypass; the console runs from PCLK1.
// The eMMC's kernel clock is ICLK on PLL1 Q at 80 MHz, as the stock firmware has it, set before
// PLL1 R: PLL1 does not change once the system runs on it.
&rcc {
	st,lse-bypass;
	assigned-clocks = <&rcc STM32U5_CLK_PLL1_SRC>, <&rcc STM32U5_CLK_SYSCLK>,
			  <&rcc STM32U5_CLK_LPTIM4>, <&rcc STM32U5_CLK_RTC>,
			  <&rcc STM32U5_CLK_LPTIM1>, <&rcc STM32U5_CLK_ICLK>,
			  <&rcc STM32U5_CLK_SDMMC1>,
			  <&rcc STM32U5_CLK_MSIS>, <&rcc STM32U5_CLK_PLL1_Q>, <&rcc STM32U5_CLK_PLL1_R>,
			  <&rcc STM32U5_CLK_HCLK>, <&rcc STM32U5_CLK_PCLK1>,
			  <&rcc STM32U5_CLK_PCLK2>, <&rcc STM32U5_CLK_PCLK3>;
	assigned-clock-parents = <&rcc STM32U5_CLK_MSIS>, <&rcc STM32U5_CLK_PLL1_R>,
				 <&rcc STM32U5_CLK_LSE>, <&rcc STM32U5_CLK_LSE>,
				 <&rcc STM32U5_CLK_LSE>, <&rcc STM32U5_CLK_PLL1_Q>,
				 <&rcc STM32U5_CLK_ICLK>,
				 <0>, <0>, <0>, <0>, <0>, <0>, <0>;
	assigned-clock-rates = <0>, <0>, <0>, <0>, <0>, <0>, <0>, <48000000>, <80000000>,
			       <160000000>, <160000000>, <160000000>, <160000000>, <160000000>;
};

&usart3 {
	pinctrl-0 = <&usart3_default>;
	pinctrl-names = "default";
	current-speed = <921600>;
	status = "okay";
};

// The buses of the core board and of the modules, each module with its EEPROM on its own. The
// devices on them come with their drivers.
&i2c1 {
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";

	// An ERM, at the voltages of the stock firmware: 2.7 V rated, 2.95 V overdrive
	// (DRV2625.cpp:140-149)
	haptics: haptics@5a {
		compatible = "ti,drv2625";
		reg = <0x5a>;
		enable-gpios = <&gpiof 2 GPIO_ACTIVE_HIGH>;
		ti,rated-voltage = <123>;
		ti,od-clamp = <137>;
	};
};

&i2c2 {
	pinctrl-0 = <&i2c2_default>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";
};

&i2c3 {
	pinctrl-0 = <&i2c3_default>;
	pinctrl-names = "default";
	clock-frequency = <1000000>;
	status = "okay";
};

&i2c4 {
	pinctrl-0 = <&i2c4_default>;
	pinctrl-names = "default";
	clock-frequency = <1000000>;
	status = "okay";
};

// The display's VCOM, FRP and XFRP, on the LSE, which keeps them running in Stop 2
&lptimer1 {
	status = "okay";
};

&lptim1_pwm {
	pinctrl-0 = <&lptim1_pwm_default>;
	pinctrl-names = "default";
	status = "okay";
};

&lptimer3 {
	status = "okay";
};

&lptim3_pwm {
	pinctrl-0 = <&lptim3_pwm_default>;
	pinctrl-names = "default";
	status = "okay";
};

// The system timer, on the LSE, which keeps running in Stop 2. LPTIM1 and LPTIM3 are the
// display's.
&lptimer4 {
	status = "okay";

	timer {
		status = "okay";
	};
};

&rtc {
	status = "okay";
};

&iwdg {
	status = "okay";
};

&rng {
	status = "okay";
};

&crc {
	status = "okay";
};

// The 4 GB eMMC, powered by EMMC_EN (PD10), which the stock firmware gives 35 ms. UNA's firmware
// splits it at fixed offsets (docs/boards/unawatch/hardware.md, section 3.3): the update drive the
// bootloader reads from 0, SYS from 100 MiB, GUI from 200 MiB, the user drive from 300 MiB.
// Nothing reads or writes GUI: the firmware's storage is its first 32 MiB.
&sdmmc1 {
	pinctrl-0 = <&sdmmc1_default>;
	pinctrl-1 = <&sdmmc1_sleep>;
	pinctrl-names = "default", "sleep";
	enable-gpios = <&gpiod 10 GPIO_ACTIVE_HIGH>;
	post-power-on-delay-ms = <35>;
	max-frequency = <52000000>;
	bus-width = <4>;
	non-removable;
	#address-cells = <1>;
	#size-cells = <1>;
	status = "okay";

	emmc_storage: flash@c800000 {
		compatible = "pebble,mmc-nor";
		reg = <0xc800000 0x2000000>;
	};
};

&internal_flash {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		// The stock bootloader, which starts the image at 0x08060000
		partition@0 {
			label = "bootloader";
			reg = <0x0 0x28000>;
			read-only;
		};

		// The libc of the stock kernel, which restoring it needs
		partition@28000 {
			label = "una-libc";
			reg = <0x28000 0x38000>;
			read-only;
		};

		// The rest of the flash: an image up to 0x1a0000 bytes also fits the 2 MiB STM32U595 of
		// early watches, which tools/una/pack_ota.py checks by default
		partition@60000 {
			label = "code";
			reg = <0x60000 0x3a0000>;
		};
	};
};
