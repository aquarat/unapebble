# The STM32U5A5QJ: 4 MiB of embedded flash.
config FLASH_SIZE
    default 0x400000

# The resources of the Pebble Round 2, whose platform the firmware takes.
config RESOURCES_BOARD
    default "getafix"

# Linked after the tether stub (tools/una/tether), which flashes and starts it,
# the code partition 128 KiB shorter: up to the system resources, at 0x280000,
# or at 0x200000 in the experiments firmware (pebble/boards/unawatch*.overlay).
config FLASH_OFFSET
    default 0x80000 if BOARD_UNAWATCH_TETHER_SLOT

config FW_FLASH_SIZE
    default 0x180000 if BOARD_UNAWATCH_TETHER_SLOT && BOARD_UNAWATCH_LAB
    default 0x200000 if BOARD_UNAWATCH_TETHER_SLOT

# The reserved boot_trace region of the devicetree
if BOOT_TRACE
config BOOT_TRACE_RAM_BASE
    default 0x2025dc00
endif

# The storage is on the eMMC: the embedded flash only holds the code and the
# system resources, read in place. The experiments firmware keeps it there,
# as the first port did.
config FLASH_STM32U5
    default n if !BOARD_UNAWATCH_LAB

# The battery: the PCA9420's charger and the MAX17262 fuel gauge, which gives
# the state of charge and the temperature charging depends on. Not in the
# experiments firmware, which starts as the first port did.
config GAUGE
    default y if !BOARD_UNAWATCH_LAB

# The sensors' shell commands, in the builds with a shell: imu, bmi270, pressure
config IMU_SHELL
    default y

config PRESSURE_SHELL
    default y

# The GNSS receiver, the AG3335M on LPUART1, powered only while something uses it, with its shell
# commands in builds that have a shell. Not in the experiments firmware.
config GNSS
    default y if !BOARD_UNAWATCH_LAB

config GNSS_SHELL
    default y if SHELL

# Bluetooth on the BlueNRG-2's own stack, through its ACI, under NimBLE's host API (decision
# 261128-081601-02), its static random address the identity; NIMBLE_HCI_BLUENRG2 has it an HCI
# controller under NimBLE's host instead. The experiments firmware keeps the fake controller.
choice NIMBLE_HCI
    default NIMBLE_ACI_BLUENRG2 if !BOARD_UNAWATCH_LAB
endchoice

choice NIMBLE_ID_ADDR_SOURCE
    default NIMBLE_ID_ADDR_BLUENRG2 if NIMBLE_HCI_BLUENRG2 || NIMBLE_ACI_BLUENRG2
endchoice

# GPS workouts: the Run, Walk and Bike apps on the receiver, through the location service,
# recording to the filesystem on the eMMC. Not in the experiments firmware.
config SERVICE_LOCATION
    default y if !BOARD_UNAWATCH_LAB

config APP_SPORT
    default y if !BOARD_UNAWATCH_LAB
