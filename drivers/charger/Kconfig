menuconfig CHARGER
    bool "Charger"
    help
      Battery charger class (pbl/drivers/charger.h).

if CHARGER

config CHARGER_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The charger shell command, to show whether external power is
      present, the charge status and the battery measurements.

config CHARGER_HIGH_LOAD
    bool
    help
      The charger driver limits the discharge current, and lifts the
      limit on pbl_charger_high_load_request().

config CHARGER_NPM1300
    bool "Nordic nPM1300"
    default y
    depends on DT_HAS_NORDIC_NPM1300_ENABLED
    select CHARGER_HIGH_LOAD
    select GPIO
    select KERNEL_SYS_WORKQ
    select KERNEL_SYS_WORKQ_HIGH
    select MFD
    select MFD_NPM1300
    help
      Support for the charger of the Nordic nPM1300 PMIC.

config CHARGER_PCA9420
    bool "NXP PCA9420"
    default y
    depends on DT_HAS_NXP_PCA9420_ENABLED
    select I2C
    select KERNEL_SYS_WORKQ
    select KERNEL_SYS_WORKQ_HIGH
    select PINCTRL
    help
      Support for the linear charger of the NXP PCA9420 PMIC. The
      regulators of the PMIC are left as they are.

config CHARGER_PCA9420_CHARGE_LIMIT_MV
    int "Charge voltage limit (mV)"
    range 0 4600
    default 0
    depends on CHARGER_PCA9420
    help
      0 charges to the constant-charge-voltage of the battery. A lower
      voltage stops the charge short of full, for a longer battery life:
      4100 charges a 4.4 V cell to about 75 to 80%. The battery's voltage
      is never exceeded.

config CHARGER_SIM
    bool "Simulator"
    default y if SOC_QEMU_PEBBLE || SOC_POSIX
    help
      Simulated charger, set through its simulator API
      (pbl/drivers/charger/sim.h).
      On a board, a stand-in for hardware without a driver yet, which
      nothing feeds.

module = DRIVER_CHARGER
module-str = Charger
source "subsys/logging/Kconfig.template.log_level"

endif # CHARGER
