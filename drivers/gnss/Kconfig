menuconfig GNSS
    bool "GNSS receiver"
    help
      Satellite positioning receiver drivers (pbl/drivers/gnss.h). The
      board instantiates the receiver it has and exports it as GNSS.

if GNSS

config GNSS_SHELL
    bool "Shell commands"
    default DRIVER_SHELL || GNSS_SIM
    depends on SHELL
    help
      The gnss shell command, to start, stop and read the receiver, and
      to drive the simulator.

config GNSS_AG3335
    bool "Airoha AG3335"
    default y
    depends on DT_HAS_AIROHA_AG3335M_ENABLED
    depends on UART
    select GPIO
    help
      The Airoha AG3335 receivers on a UART, powered by an enable line:
      NMEA sentences, set up with the receiver's PAIR commands.

config GNSS_AG3335_DUAL_BAND
    bool "L1 and L5"
    depends on GNSS_AG3335
    help
      Receive the L5 band as well as L1 (PAIR104). Off, as UNA's
      firmware runs the receiver, on L1 alone.

config GNSS_AG3335_SLEEP
    bool "Let the receiver's system sleep"
    depends on GNSS_AG3335
    help
      Unlock the sleep of the receiver's own system (PAIR382,0) once it
      is set up. UNA's firmware keeps it locked on L1 alone.

config GNSS_SIM
    bool "Simulator"
    depends on SOC_QEMU_PEBBLE || SOC_POSIX
    help
      Simulated receiver, replaying a built-in looped running route at
      1 Hz, or the fixes set through its simulator API
      (pbl/drivers/gnss/sim.h).

config GNSS_REPLAY
    bool "Replay the simulator's route over a receiver"
    default y if !RELEASE
    depends on GNSS_SHELL && !GNSS_SIM
    help
      The gnss replay command: while on, every epoch of the real
      receiver is reported as a 3D fix on the simulator's route, one
      second along it, keeping the receiver's time, its power and its
      timing. For testing recorders indoors; off at every start.

config GNSS_SIM_TIME_TO_FIX
    int "Simulated time to first fix (s)"
    default 8
    depends on GNSS_SIM
    help
      Epochs without a position the simulator reports after it starts.

module = DRIVER_GNSS
module-str = GNSS receiver
source "subsys/logging/Kconfig.template.log_level"

endif # GNSS
