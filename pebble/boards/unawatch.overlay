// The firmware's storage, on the eMMC, in the 32 MiB window of its GUI region the board gives it
// (unawatch.dts): offsets are from the start of the window, 200 MiB into the eMMC. The bootloader
// leaves the region alone, so the filesystem, the logs and the resources survive an update.
//
// The window is read and written in 512-byte blocks, as NOR flash in 4 KiB subsectors and 64 KiB
// sectors: every partition is a whole number of subsectors, the filesystem of sectors. What the
// partitions leave of the window is free.

// The gabbro platform's 260 x 260 framebuffer, of which the 240 x 240 panel shows the centre
&display {
	width = <260>;
	height = <260>;
};

&emmc_storage {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		// Two banks: the resources of the firmware that runs, which it copies from the update
		// drive when neither holds them (pebble/resource/resource_storage_volume.c), and those of
		// the one before
		partition@0 {
			label = "system-resources-bank-0";
			reg = <0x0 0x400000>;
		};

		partition@400000 {
			label = "system-resources-bank-1";
			reg = <0x400000 0x400000>;
		};

		// Only protected: there is no recovery firmware to keep
		partition@800000 {
			label = "safe-firmware";
			reg = <0x800000 0x2000>;
		};

		partition@802000 {
			label = "mfg-info";
			reg = <0x802000 0x2000>;
		};

		partition@804000 {
			label = "tzinfo";
			reg = <0x804000 0x2000>;
		};

		partition@806000 {
			label = "shared-prf-storage";
			reg = <0x806000 0x2000>;
		};

		// Core dumps, which take the RAM in use
		partition@900000 {
			label = "scratch";
			reg = <0x900000 0x400000>;
		};

		// As large as the flash log goes: fewer than 256 pages of 4 KiB
		partition@d00000 {
			label = "debug-db";
			reg = <0xd00000 0x80000>;
		};

		partition@1000000 {
			label = "filesystem";
			reg = <0x1000000 0x1000000>;
		};
	};
};
