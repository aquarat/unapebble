config SERVICE_BATTERY
    bool "Battery"
    help
      Battery monitor and state-of-charge estimation.

choice BATTERY_SOC
    prompt "State-of-charge estimation"
    default BATTERY_SOC_GAUGE if GAUGE
    default NRF_FUEL_GAUGE if CHARGER_NPM1300
    default BATTERY_SOC_VOLTAGE

config BATTERY_SOC_VOLTAGE
    bool "Voltage curve"
    help
      Look the state of charge up in a voltage curve.

config NRF_FUEL_GAUGE
    bool "Nordic nRF Fuel Gauge"
    depends on CHARGER_NPM1300
    help
      Use the Nordic nRF Fuel Gauge library for state-of-charge
      estimation. Requires the nPM1300 PMIC; selects both the prebuilt
      nonfree fuel-gauge lib and the matching battery service impl.

config BATTERY_SOC_FUEL_GAUGE
    bool "Fuel gauge"
    depends on CHARGER_NPM1300
    depends on BATTERY_SIMPLE
    select FUEL_GAUGE
    help
      Use the open fuel gauge (lib/fuel_gauge), with the capacity, the
      internal resistance and the open-circuit voltage curve of the battery
      in the devicetree.

config BATTERY_SOC_GAUGE
    bool "Fuel gauge chip"
    depends on GAUGE
    help
      Take the state of charge from the board's fuel gauge chip
      (pbl/drivers/gauge.h), and allow charging only while it reads a
      battery temperature between 0 and 45 degrees C.

endchoice

if SERVICE_BATTERY

config SERVICE_BATTERY_LOW_POWER_PERCENT
    int "Low power threshold (%)"
    range 1 100
    default 2
    help
      Battery percentage below which the watch enters low power mode.

config SERVICE_BATTERY_CAPACITY_HOURS
    int "Battery life (hours)"
    range 1 65535
    default 168
    help
      Approximate hours of battery life on a full charge, used to convert
      between charge percentage and remaining time.

config BATTERY_WARNING_FIRST_PERCENT
    int "First battery warning threshold (%)"
    range 0 100
    default 0
    help
      Battery percentage for the first warning. A value of 0 uses the
      default time-based threshold of 18 hours remaining.

config BATTERY_WARNING_SECOND_PERCENT
    int "Second battery warning threshold (%)"
    range 0 100
    default 0
    help
      Battery percentage for the second warning. A value of 0 uses the
      default time-based threshold of 12 hours remaining.

config BATTERY_TEST
    bool "Battery capacity test"
    depends on BATTERY_SOC_GAUGE
    help
      The Battery test app and its logger: charges to full, discharges
      to the low battery power-off and charges again, counting the
      charge with the fuel gauge's coulomb counter and an integral of
      its current. Logs to the filesystem across the power-off; the
      "battery test" shell commands print the log and the results.

module = SERVICE_BATTERY
module-str = Battery
source "subsys/logging/Kconfig.template.log_level"

endif
